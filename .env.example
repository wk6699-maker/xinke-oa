# Local website storage (the checked-in local database file)
STORAGE_MODE=sqlite
SQLITE_PATH=./data/xinke-email.sqlite
LOCAL_SQLITE_FALLBACK=false
API_PORT=8788

# Optional MySQL connection for a server deployment
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=xinke_oa
MYSQL_CONNECTION_LIMIT=10

# Alternatively use one URL instead of the MYSQL_* variables:
# DATABASE_URL=mysql://root:change-me@127.0.0.1:3306/xinke_oa

# Server-side SMTP delivery for scheduled collection reminders
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=oa@xinke.com
SMTP_PASSWORD=change-me
SMTP_FROM=oa@xinke.com
# Set false only when the SMTP provider uses a private/self-signed certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true
